# --- PlatformIO ---
.pio/
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch/

# --- Python ---
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# --- Jupyter ---
.ipynb_checkpoints/

# --- Generated artifacts (regenerable, not source) ---
# Comment these out if you'd rather commit a specific trained model/dataset
# for reproducibility; left ignored by default since they can get large.
training/data/*.npz
pi-side/model/model.tflite
pi-side/model/labels.json
pi-side/model/scaler.json
pi-side/model/train_report.json
pi-side/tools/results/

# --- OS/editor cruft ---
.DS_Store
Thumbs.db

# --- Native test binaries (built by firmware/tests/native/run_all.sh) ---
*.exe
firmware/tests/native/test_packet_logic
firmware/tests/native/test_frame_logic

# --- Test outputs (recordings/logs from hardware testing; use `git add -f` to commit deliberately) ---
training/data/*/
pi-side/results/
